<?xml version='1.0' encoding='utf-8'?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>
    <session-factory>
        <!-- Database connection settings -->
        <property name="connection.driver_class">org.h2.Driver</property>
        <!-- File-based H2 database named 'movietheaterdb' stored in the project root -->
        <property name="connection.url">jdbc:h2:file:./movietheaterdb;DB_CLOSE_DELAY=-1</property>
        <property name="connection.username">sa</property>
        <property name="connection.password"></property>

        <!-- JDBC connection pool (built-in) -->
        <property name="connection.pool_size">5</property>

        <!-- SQL dialect -->
        <property name="dialect">org.hibernate.dialect.H2Dialect</property>

        <!-- Echo all executed SQL to stdout -->
        <property name="show_sql">true</property>

        <!-- Format the generated SQL -->
        <property name="format_sql">true</property>

        <!-- Drop and re-create schema on startup -->
        <property name="hbm2ddl.auto">create</property>

        <!-- Mapped entity classes -->
        <mapping class="fa.training.entities.CinemaRoom"/>
        <mapping class="fa.training.entities.CinemaRoomDetail"/>
        <mapping class="fa.training.entities.Seat"/>

    </session-factory>
</hibernate-configuration>
