<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <!-- Database Connection Settings (Using Derby Embedded for fadb) -->
        <property name="hibernate.connection.driver_class">org.apache.derby.jdbc.EmbeddedDriver</property>
        <property name="hibernate.connection.url">jdbc:derby:memory:fadb;create=true</property>
        <property name="hibernate.connection.username">sa</property>

        <!-- Hibernate Dialect for Derby 10.7+ -->
        <property name="hibernate.dialect">org.hibernate.dialect.DerbyTenSevenDialect</property>

        <!-- Echo all executed SQL to stdout -->
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>

        <!-- Drop and re-create the database schema on startup -->
        <property name="hibernate.hbm2ddl.auto">update</property>

        <!-- Connection Pooling -->
        <property name="hibernate.connection.pool_size">10</property>

        <!-- Mapping Entity Class -->
        <mapping class="fa.training.entities.Employee"/>
    </session-factory>
</hibernate-configuration>
