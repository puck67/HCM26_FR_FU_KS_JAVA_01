<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <!-- Database Connection Settings -->
        <!-- H2 Configuration (embedded in-memory database) -->
        <property name="hibernate.connection.driver_class">org.h2.Driver</property>
        <!-- Fresh database every JVM run; keep MySQL-compatible SQL mode -->
        <property name="hibernate.connection.url">jdbc:h2:mem:movietheaterdb;MODE=MySQL;DATABASE_TO_LOWER=TRUE;DB_CLOSE_DELAY=-1</property>
        <property name="hibernate.connection.username">sa</property>

        <!-- Hibernate Dialect -->
        <property name="hibernate.dialect">org.hibernate.dialect.H2Dialect</property>

        <!-- Echo all executed SQL to stdout -->
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>

        <!-- Drop and re-create the database schema on startup -->
        <!-- Use 'create' to drop and create tables, 'update' to only add new tables/columns -->
        <property name="hibernate.hbm2ddl.auto">update</property>

        <!-- Connection Pooling -->
        <property name="hibernate.connection.pool_size">20</property>

        <!-- Mapping files and Entity classes -->
        <mapping class="fa.training.entities.CinemaRoom"/>
        <mapping class="fa.training.entities.CinemaRoomDetail"/>
        <mapping class="fa.training.entities.Seat"/>
    </session-factory>
</hibernate-configuration>
