<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE hibernate-configuration SYSTEM
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <!-- Database connection settings (H2 Local Database) -->
        <property name="hibernate.connection.driver_class">org.h2.Driver</property>
        <property name="hibernate.connection.url">jdbc:h2:./db/movietheaterdb;DB_CLOSE_DELAY=-1;AUTO_SERVER=TRUE</property>
        <property name="hibernate.connection.username">sa</property>
        <property name="hibernate.connection.password"></property>

        <!-- JDBC connection pool -->
        <property name="hibernate.connection.pool_size">5</property>

        <!-- SQL dialect -->
        <property name="hibernate.dialect">org.hibernate.dialect.H2Dialect</property>

        <!-- Enable Hibernate's automatic session context management -->
        <property name="hibernate.current_session_context_class">thread</property>

        <!-- Echo SQL -->
        <property name="hibernate.show_sql">false</property>
        <property name="hibernate.format_sql">false</property>

        <!-- Automatically validate/update schema on startup -->
        <property name="hibernate.hbm2ddl.auto">update</property>

        <!-- Registered entity classes -->
        <mapping class="fa.training.entities.CinemaRoom"/>
        <mapping class="fa.training.entities.Seat"/>
        <mapping class="fa.training.entities.CinemaRoomDetail"/>
    </session-factory>
</hibernate-configuration>
