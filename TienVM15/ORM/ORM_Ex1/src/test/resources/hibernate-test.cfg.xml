<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE hibernate-configuration SYSTEM
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <!-- H2 In-Memory Database connection settings for Testing -->
        <property name="hibernate.connection.driver_class">org.h2.Driver</property>
        <property name="hibernate.connection.url">jdbc:h2:mem:testdb;DB_CLOSE_DELAY=-1</property>
        <property name="hibernate.connection.username">sa</property>
        <property name="hibernate.connection.password"></property>

        <!-- JDBC connection pool -->
        <property name="hibernate.connection.pool_size">2</property>

        <!-- H2 Dialect -->
        <property name="hibernate.dialect">org.hibernate.dialect.H2Dialect</property>

        <!-- Current session context -->
        <property name="hibernate.current_session_context_class">thread</property>

        <!-- DDL auto: create-drop for unit tests to start clean -->
        <property name="hibernate.hbm2ddl.auto">create-drop</property>

        <!-- Logging level -->
        <property name="hibernate.show_sql">false</property>
        <property name="hibernate.format_sql">false</property>

        <!-- Registered entity classes -->
        <mapping class="com.practice.entity.Student"/>
        <mapping class="com.practice.entity.Course"/>
    </session-factory>
</hibernate-configuration>
